#!/usr/bin/env python3
"""agents-sync - one source of truth (~/.agents) for skills, agents, MCP servers and
global instructions, synced into Claude Code, Codex and Cursor.

Each run:  1. IMPORT  anything new found in a harness folder into the hub
           2. NORMALIZE  (shorten long agent descriptions, keep the full text)
           3. EXPORT  the hub into every harness (only touching what it manages)
           4. GROUP   rebuild ~/.agents/groups (browsing view)
           5. COMMIT  to git, and push if a remote is set

Usage: agents-sync [--dry-run] [--with-experimental] [--no-push] [--quiet]
                   [--project DIR] [--unproject DIR]   (Cursor CLI: link agents into DIR/.cursor/agents)
"""
import json, os, re, shutil, subprocess, sys, tomllib
from pathlib import Path

HOME = Path.home()
HUB = HOME / ".agents"
SKILLS, AGENTS, EXP = HUB / "skills", HUB / "agents", HUB / "experimental"
MCP_FILE, ENV_FILE = HUB / "mcp" / "servers.json", HUB / ".env"
INSTR = HUB / "instructions" / "AGENTS.md"
STATE = HUB / "state" / "managed.json"
GROUPS_FILE = HUB / "groups.json"

CLAUDE_SKILLS, CLAUDE_AGENTS = HOME / ".claude/skills", HOME / ".claude/agents"
CODEX_SKILLS, CODEX_AGENTS = HOME / ".codex/skills", HOME / ".codex/agents"
CURSOR_SKILLS, CURSOR_AGENTS = HOME / ".cursor/skills", HOME / ".cursor/agents"
CLAUDE_JSON, CODEX_TOML, CURSOR_MCP = HOME / ".claude.json", HOME / ".codex/config.toml", HOME / ".cursor/mcp.json"
CLAUDE_MD, CODEX_MD, CURSOR_RULE = HOME / ".claude/CLAUDE.md", HOME / ".codex/AGENTS.md", HOME / ".cursor/rules/agents-hub.mdc"

# Folders each app manages itself: never imported, never touched.
SKIP_SKILL_DIRS = {"synced", ".system"}
DESC_CAP = 160
GEN_MARK = "# generated by agents-sync from ~/.agents/agents - edit the .md there, not this file"
MCP_BEGIN, MCP_END = "# >>> agents-sync mcp (generated - edit ~/.agents/mcp/servers.json) >>>", "# <<< agents-sync mcp <<<"

argv = sys.argv[1:]
args = set(argv)
DRY, WITH_EXP, NO_PUSH, QUIET = "--dry-run" in args, "--with-experimental" in args, "--no-push" in args, "--quiet" in args


def opt_values(flag):
    return [str(Path(argv[i + 1]).expanduser().resolve()) for i, a in enumerate(argv) if a == flag and i + 1 < len(argv)]


# Cursor's CLI only loads subagents from <project>/.cursor/agents, so projects are registered:
#   agents-sync --project ~/Workspace/app     (once; every later sync keeps it current)
#   agents-sync --unproject ~/Workspace/app
ADD_PROJECTS, DROP_PROJECTS = opt_values("--project"), opt_values("--unproject")
log_lines = []


def log(msg):
    log_lines.append(msg)
    if not QUIET:
        print(msg)


def load_json(p, default):
    try:
        return json.loads(Path(p).read_text())
    except FileNotFoundError:
        return default


def write_text(p, text):
    if DRY:
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(p.name + ".agents-sync.tmp")
    tmp.write_text(text)
    os.replace(tmp, p)


def link(src, dst):
    """Make dst a relative symlink to src (replacing an old managed link)."""
    rel = os.path.relpath(src, dst.parent)
    if dst.is_symlink() and os.readlink(dst) == rel:
        return False
    if dst.exists() and not dst.is_symlink():
        log(f"  ! skip {dst}: a real file is there (import should have moved it)")
        return False
    if not DRY:
        dst.parent.mkdir(parents=True, exist_ok=True)
        if dst.is_symlink():
            dst.unlink()
        os.symlink(rel, dst)
    return True


def points_into_hub(p):
    return p.is_symlink() and str(HUB) in str((p.parent / os.readlink(p)).resolve(strict=False))


def prune_links(folder, keep_names):
    """Remove hub links in folder that the hub no longer provides."""
    if not folder.is_dir():
        return
    for p in folder.iterdir():
        if points_into_hub(p) and p.name not in keep_names:
            log(f"  - unlink {p}")
            if not DRY:
                p.unlink()


# ---------------------------------------------------------------- frontmatter
FM = re.compile(r"\A---\n(.*?)\n---\n?", re.S)


def split_fm(text):
    m = FM.match(text)
    if not m:
        return None, text
    return m.group(1), text[m.end():]


def fm_get(fm, key):
    m = re.search(rf"^{key}:[ \t]*(.*)$", fm, re.M)
    if not m:
        return None
    v = m.group(1).strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        try:
            return json.loads(v) if v[0] == '"' else v[1:-1].replace("''", "'")
        except json.JSONDecodeError:
            return v[1:-1]
    return v


def yaml_plain_ok(v):
    """Can v be written without quotes? (Cursor shows quotes literally, so avoid them.)"""
    return bool(v) and v[0] not in "\"'&*!|>%@`[]{},#?:-" and ": " not in v and " #" not in v \
        and not v.endswith(":") and v == v.strip()


def fm_set(fm, key, value, after=None):
    shown = value if yaml_plain_ok(value) else json.dumps(value, ensure_ascii=False)
    line = f"{key}: {shown}"
    if re.search(rf"^{key}:", fm, re.M):
        return re.sub(rf"^{key}:.*$", lambda _: line, fm, count=1, flags=re.M)
    if after and re.search(rf"^{after}:", fm, re.M):
        return re.sub(rf"^({after}:.*)$", lambda m: m.group(1) + "\n" + line, fm, count=1, flags=re.M)
    return fm + "\n" + line


def shorten(d):
    d = " ".join(d.split())
    if len(d) <= DESC_CAP:
        return d
    best = -1
    for sep in (" — ", " - ", ". ", "; ", ": "):
        for m in re.finditer(re.escape(sep), d):
            if 60 <= m.start() <= DESC_CAP:
                best = max(best, m.start())
    if best > 0:
        return d[:best].rstrip(" .,;:")
    cut = d[: DESC_CAP - 1]
    cut = cut[: cut.rfind(" ")].rstrip(" ,;:—-")
    cut = re.sub(r"\s+(and|or|the|a|an|of|for|with|to|in)$", "", cut)
    return cut + "…"


# ---------------------------------------------------------------- 1. import
def import_skills():
    for folder in (CLAUDE_SKILLS, CODEX_SKILLS, CURSOR_SKILLS):
        if not folder.is_dir():
            continue
        for p in folder.iterdir():
            if p.name in SKIP_SKILL_DIRS or p.name.startswith(".") or p.is_symlink() or not p.is_dir():
                continue
            if not (p / "SKILL.md").exists():
                continue
            dest = SKILLS / p.name
            if dest.exists():
                if not DRY:
                    shutil.rmtree(dest)
                log(f"  ↻ skill {p.name}: newer copy from {folder} replaces hub copy (old one is in git)")
            else:
                log(f"  + skill {p.name} imported from {folder}")
            if not DRY:
                shutil.move(str(p), str(dest))


def import_agents():
    for folder in (CLAUDE_AGENTS, CURSOR_AGENTS):
        if not folder.is_dir():
            continue
        for p in sorted(folder.glob("*.md")):
            if p.is_symlink():
                continue
            dest = AGENTS / p.name
            same = dest.exists() and dest.read_text() == p.read_text()
            if not same:
                log(f"  {'↻' if dest.exists() else '+'} agent {p.stem} imported from {folder}")
            if not DRY:
                if same:
                    p.unlink()
                else:
                    shutil.move(str(p), str(dest))
    # Codex agents someone made by hand (not generated by us) become hub agents.
    if CODEX_AGENTS.is_dir():
        for p in CODEX_AGENTS.glob("*.toml"):
            text = p.read_text()
            if text.startswith(GEN_MARK):
                continue
            try:
                d = tomllib.loads(text)
            except tomllib.TOMLDecodeError:
                log(f"  ! skip {p}: not valid TOML")
                continue
            dest = AGENTS / f"{p.stem}.md"
            md = (f"---\nname: {json.dumps(d.get('name', p.stem))}\n"
                  f"description: {json.dumps(d.get('description', ''), ensure_ascii=False)}\n---\n\n"
                  f"{d.get('developer_instructions', '')}\n")
            log(f"  + agent {p.stem} imported from Codex")
            if not DRY:
                dest.write_text(md)
                p.unlink()


SECRETISH_KEY = re.compile(r"(key|token|secret|password|passwd|auth|cookie)", re.I)
SECRETISH_VAL = re.compile(r"[A-Za-z0-9_\-]{24,}")


def env_var(name, field):
    return re.sub(r"[^A-Z0-9]+", "_", f"{name}_{field}".upper()).strip("_")


def secret_out(name, field, value, env):
    var = env_var(name, field)
    env[var] = value
    return "${" + var + "}"


def redact_server(name, spec, env):
    """Move secret-looking values into .env and leave ${VAR} placeholders."""
    spec = json.loads(json.dumps(spec))
    for tbl in ("env", "headers"):
        for k, v in list(spec.get(tbl, {}).items()):
            if isinstance(v, str) and "${" not in v and (SECRETISH_KEY.search(k) or SECRETISH_VAL.search(v)):
                spec[tbl][k] = secret_out(name, k, v, env)
    if isinstance(spec.get("url"), str) and SECRETISH_VAL.search(spec["url"]) and "${" not in spec["url"]:
        spec["url"] = secret_out(name, "url", spec["url"], env)
    for i, a in enumerate(spec.get("args", [])):
        if isinstance(a, str) and "${" not in a and SECRETISH_VAL.search(a) and ("://" in a or len(a) > 30):
            spec["args"][i] = secret_out(name, f"arg{i}", a, env)
    return spec


def from_claude(v):
    s = {k: v[k] for k in ("command", "args", "env", "url", "headers", "cwd") if k in v}
    return s


def from_cursor(v):
    return {k: v[k] for k in ("command", "args", "env", "url", "headers", "cwd") if k in v}


CODEX_CORE = {"command", "args", "env", "url", "cwd", "http_headers"}


def from_codex(v):
    s = {k: v[k] for k in ("command", "args", "env", "url", "cwd") if k in v}
    if "http_headers" in v:
        s["headers"] = v["http_headers"]
    extra = {k: v[k] for k in v if k not in CODEX_CORE}
    if extra:
        s["extra"] = {"codex": extra}
    return s


def same_core(a, b):
    core = lambda s: {k: s.get(k) for k in ("command", "args", "env", "url", "headers")}
    return core(a) == core(b)


def import_mcp(hub, env):
    servers, unmanaged = hub["servers"], set(hub.get("unmanaged", []))
    found = []  # (harness, name, spec)
    cj = load_json(CLAUDE_JSON, {})
    for n, v in cj.get("mcpServers", {}).items():
        found.append(("claude", n, from_claude(v)))
    for n, v in load_json(CURSOR_MCP, {}).get("mcpServers", {}).items():
        found.append(("cursor", n, from_cursor(v)))
    if CODEX_TOML.exists():
        for n, v in tomllib.loads(CODEX_TOML.read_text()).get("mcp_servers", {}).items():
            found.append(("codex", n, from_codex(v)))
    state = load_json(STATE, {})
    for harness, n, spec in found:
        if n in unmanaged:
            continue
        if n in state.get(f"{harness}_mcp", []):
            continue  # we wrote it; the hub already has it
        spec = redact_server(n, spec, env)
        if n in servers:
            h = servers[n]
            if harness not in h.setdefault("targets", []):
                h["targets"].append(harness)
            if not same_core(h, spec):
                log(f"  ! MCP {n}: {harness} has a different setup than the hub; the hub's wins (check servers.json)")
            if spec.get("extra"):
                h.setdefault("extra", {}).update(spec["extra"])
            log(f"  + MCP {n}: now also synced to {harness}")
        else:
            spec["targets"] = [harness]
            servers[n] = spec
            log(f"  + MCP {n} imported from {harness}")


# ---------------------------------------------------------------- 2. normalize
def normalize_agents(folder):
    total = 0
    for p in sorted(folder.glob("*.md")):
        text = p.read_text()
        fm, body = split_fm(text)
        if fm is None:
            log(f"  ! {p.name}: no frontmatter, skipped")
            continue
        desc = fm_get(fm, "description") or ""
        full = fm_get(fm, "full_description")
        raw = re.search(r"^description:[ \t]*(.*)$", fm, re.M)
        quoted_needlessly = raw and raw.group(1)[:1] in "\"'" and yaml_plain_ok(desc)
        if len(desc) > DESC_CAP or quoted_needlessly:
            if len(desc) > DESC_CAP:
                if not full:
                    fm = fm_set(fm, "full_description", " ".join(desc.split()), after="description")
                desc = shorten(desc)
            fm = fm_set(fm, "description", desc)
            if not DRY:
                p.write_text(f"---\n{fm}\n---\n{body}")
        total += len(desc) + len(fm_get(fm, "name") or "")
    return total


# ---------------------------------------------------------------- 3. export
def expand(value, env, missing):
    def rep(m):
        v = env.get(m.group(1), os.environ.get(m.group(1)))
        if v is None:
            missing.add(m.group(1))
            return m.group(0)
        return v
    if isinstance(value, str):
        return re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", rep, value)
    if isinstance(value, list):
        return [expand(x, env, missing) for x in value]
    if isinstance(value, dict):
        return {k: expand(v, env, missing) for k, v in value.items()}
    return value


def to_claude(s):
    if "url" in s:
        out = {"type": s.get("transport", "http"), "url": s["url"]}
        if s.get("headers"):
            out["headers"] = s["headers"]
    else:
        out = {"type": "stdio", "command": s["command"], "args": s.get("args", [])}
        if s.get("env"):
            out["env"] = s["env"]
    out.update(s.get("extra", {}).get("claude", {}))
    return out


def to_cursor(s):
    out = {k: s[k] for k in ("command", "args", "env", "url", "headers") if k in s}
    out.update(s.get("extra", {}).get("cursor", {}))
    return out


def toml_val(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_val(x) for x in v) + "]"
    return json.dumps(v, ensure_ascii=False)


def toml_key(k):
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k)


def to_codex_toml(name, s):
    base = {k: s[k] for k in ("command", "args", "url", "cwd") if k in s}
    base.update(s.get("extra", {}).get("codex", {}))
    tables = {}
    if s.get("env"):
        tables["env"] = s["env"]
    if s.get("headers"):
        tables["http_headers"] = s["headers"]
    lines = [f"[mcp_servers.{toml_key(name)}]"]
    lines += [f"{toml_key(k)} = {toml_val(v)}" for k, v in base.items() if not isinstance(v, dict)]
    for tname, tbl in tables.items():
        lines += ["", f"[mcp_servers.{toml_key(name)}.{tname}]"]
        lines += [f"{toml_key(k)} = {toml_val(v)}" for k, v in tbl.items()]
    return "\n".join(lines)


def strip_codex_tables(text, names):
    """Remove [mcp_servers.NAME] / [mcp_servers.NAME.*] sections (and our old block)."""
    text = re.sub(re.escape(MCP_BEGIN) + r".*?" + re.escape(MCP_END) + r"\n?", "", text, flags=re.S)
    out, skipping = [], False
    hdr = re.compile(r"^\s*\[\s*mcp_servers\.(\"[^\"]+\"|[A-Za-z0-9_-]+)(\.[^\]]*)?\s*\]\s*$")
    for line in text.splitlines():
        if re.match(r"^\s*\[", line):
            m = hdr.match(line)
            skipping = bool(m and m.group(1).strip('"') in names)
        if not skipping:
            out.append(line)
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)).rstrip() + "\n"


def export_mcp(hub, env, state):
    servers = {n: s for n, s in hub["servers"].items() if s.get("enabled", True)}
    missing = set()
    want = {h: {} for h in ("claude", "codex", "cursor")}
    for n, s in servers.items():
        miss = set()
        s2 = expand(s, env, miss)
        if miss:
            log(f"  ! MCP {n} skipped: set {', '.join(sorted(miss))} in ~/.agents/.env")
            missing |= miss
            continue
        for h in s.get("targets", ["claude", "codex", "cursor"]):
            want[h][n] = s2

    # Claude Code: through its own CLI (safe while Claude is running)
    cur = load_json(CLAUDE_JSON, {}).get("mcpServers", {})
    for n in state.get("claude_mcp", []):
        if n not in want["claude"] and n in cur:
            log(f"  - Claude MCP {n}")
            DRY or subprocess.run(["claude", "mcp", "remove", "-s", "user", n], capture_output=True)
    for n, s in want["claude"].items():
        spec = to_claude(s)
        if cur.get(n) == spec:
            continue
        log(f"  → Claude MCP {n}")
        if not DRY:
            if n in cur:
                subprocess.run(["claude", "mcp", "remove", "-s", "user", n], capture_output=True)
            r = subprocess.run(["claude", "mcp", "add-json", "-s", "user", n, json.dumps(spec)], capture_output=True, text=True)
            if r.returncode:
                log(f"  ! Claude MCP {n}: {r.stderr.strip() or r.stdout.strip()}")
    state["claude_mcp"] = sorted(want["claude"])

    # Cursor: ~/.cursor/mcp.json, only our keys
    cj = load_json(CURSOR_MCP, {"mcpServers": {}})
    ms = cj.setdefault("mcpServers", {})
    before = json.dumps(ms, sort_keys=True)
    for n in state.get("cursor_mcp", []):
        if n not in want["cursor"]:
            ms.pop(n, None)
    for n, s in want["cursor"].items():
        ms[n] = to_cursor(s)
    if json.dumps(ms, sort_keys=True) != before:
        log(f"  → Cursor MCP: {', '.join(sorted(want['cursor'])) or '(none)'}")
        write_text(CURSOR_MCP, json.dumps(cj, indent=2) + "\n")
    state["cursor_mcp"] = sorted(want["cursor"])

    # Codex: one generated block at the end of config.toml
    if CODEX_TOML.exists():
        text = CODEX_TOML.read_text()
        names = set(want["codex"]) | set(state.get("codex_mcp", []))
        new = strip_codex_tables(text, names)
        if want["codex"]:
            new += "\n" + MCP_BEGIN + "\n" + "\n\n".join(to_codex_toml(n, s) for n, s in sorted(want["codex"].items())) + "\n" + MCP_END + "\n"
        tomllib.loads(new)  # never write a config Codex can't read
        if new != text:
            log(f"  → Codex MCP: {', '.join(sorted(want['codex'])) or '(none)'}")
            if not DRY:
                shutil.copy2(CODEX_TOML, HUB / "state" / "codex-config.toml.bak")
            write_text(CODEX_TOML, new)
    state["codex_mcp"] = sorted(want["codex"])


def export_skills():
    names = {p.name for p in SKILLS.iterdir() if (p / "SKILL.md").exists()}
    exp = {p.name: p for p in (EXP / "skills").iterdir() if (p / "SKILL.md").exists()} if WITH_EXP and (EXP / "skills").is_dir() else {}
    changed = 0
    for n in names:
        changed += link(SKILLS / n, CLAUDE_SKILLS / n)
    for n, p in exp.items():  # Codex/Cursor read ~/.agents/skills itself; experiments need links
        for f in (CLAUDE_SKILLS, CODEX_SKILLS, CURSOR_SKILLS):
            changed += link(p, f / n)
    prune_links(CLAUDE_SKILLS, names | set(exp))
    prune_links(CODEX_SKILLS, set(exp))
    prune_links(CURSOR_SKILLS, set(exp))
    if changed:
        log(f"  → skills: {changed} links updated")


def agent_name(p):
    fm, _ = split_fm(p.read_text())
    return (fm_get(fm, "name") if fm else None) or p.stem


def project_own_agents(proj):
    """Agent files and names a project defines itself (real files, not our hub links)."""
    own = set()
    for sub in (".cursor/agents", ".claude/agents", ".agents/agents"):
        folder = proj / sub
        if not folder.is_dir():
            continue
        for p in folder.glob("*.md"):
            if points_into_hub(p):
                continue
            own.add(p.name)
            try:
                own.add(agent_name(p))
            except OSError:
                pass
    return own


def report_skill_overlap(proj):
    """Project skills are the project's: never touched. Warn where a hub skill shares a name,
    because Claude Code lets a personal skill shadow a project one (Codex lets the project win)."""
    seen = set()
    for sub in (".claude/skills", ".agents/skills", ".cursor/skills", ".codex/skills"):
        folder = proj / sub
        if folder.is_dir():
            seen |= {p.name for p in folder.iterdir() if (p / "SKILL.md").exists()}
    clash = sorted(n for n in seen if (SKILLS / n / "SKILL.md").exists())

    def canon(folder):
        # Content only: ignore formatting a project's Prettier applies (spaces, list markers, quotes).
        out = {}
        for f in sorted(folder.rglob("*")):
            if f.is_file() and f.suffix.lower() in (".md", ".yaml", ".yml", ".txt", ".json"):
                t = f.read_text(errors="ignore")
                t = re.sub(r"(?m)^[ \t>]*(\d+[.)]|[-*+])[ \t]+", "", t)  # list markers / numbering
                t = re.sub(r"\\([\\`*_{}\[\]()#+\-.!|<>])", r"\1", t)     # markdown escapes
                out[str(f.relative_to(folder))] = re.sub(r"[\s*'\"`_;()-]", "", t)
        return out

    def project_copy(n):
        for sub in (".claude/skills", ".agents/skills", ".cursor/skills", ".codex/skills"):
            if (proj / sub / n / "SKILL.md").exists():
                return proj / sub / n

    differ = []
    for n in clash:
        mine, theirs = canon(SKILLS / n), canon(project_copy(n))
        shared = set(mine) & set(theirs)
        if any(mine[k] != theirs[k] for k in shared) or set(theirs) - set(mine):
            differ.append(n)
    if differ:
        log(f"  ! {proj.name}: {len(differ)} skill(s) share a name with the hub but differ "
            f"(in Claude Code the hub copy wins there): {', '.join(differ)}")


def agent_files():
    files = {p.name: p for p in AGENTS.glob("*.md")}
    if WITH_EXP and (EXP / "agents").is_dir():
        files.update({p.name: p for p in (EXP / "agents").glob("*.md")})
    return files


def export_agents(state):
    files = agent_files()
    changed = 0
    for n, p in files.items():
        changed += link(p, CLAUDE_AGENTS / n)
        changed += link(p, CURSOR_AGENTS / n)
    prune_links(CLAUDE_AGENTS, set(files))
    prune_links(CURSOR_AGENTS, set(files))
    # Cursor projects: per-project .cursor/agents links
    projects = (set(state.get("cursor_projects", [])) | set(ADD_PROJECTS)) - set(DROP_PROJECTS)
    for d in DROP_PROJECTS:
        prune_links(Path(d) / ".cursor" / "agents", set())
    for d in sorted(projects):
        if not Path(d).is_dir():
            log(f"  ! Cursor project {d} is gone; dropping it")
            continue
        pa = Path(d) / ".cursor" / "agents"
        # The project's own agents always win: never link a hub agent over one it defines.
        own = project_own_agents(Path(d))
        wanted = {n: p for n, p in files.items() if n not in own and agent_name(p) not in own}
        for n, p in wanted.items():
            changed += link(p, pa / n)
        prune_links(pa, set(wanted))
        if len(wanted) < len(files):
            log(f"  · {Path(d).name}: {len(files) - len(wanted)} hub agents skipped (the project has its own)")
        report_skill_overlap(Path(d))
        if d in ADD_PROJECTS:
            log(f"  + Cursor project {d}: agents linked into .cursor/agents")
            # keep the links out of that repo's git status (local exclude, never committed)
            gitdir = Path(d) / ".git"
            if gitdir.is_dir() and not DRY:
                tracked = subprocess.run(["git", "-C", d, "ls-files", ".cursor/agents"], capture_output=True, text=True).stdout.strip()
                ex = gitdir / "info" / "exclude"
                ex.parent.mkdir(parents=True, exist_ok=True)
                cur = ex.read_text() if ex.exists() else ""
                if not tracked and "/.cursor/agents/" not in cur:
                    ex.write_text(cur.rstrip("\n") + "\n# agents-sync links\n/.cursor/agents/\n")
    state["cursor_projects"] = sorted(d for d in projects if Path(d).is_dir())
    # Codex: generated TOML
    made = set()
    for n, p in files.items():
        fm, body = split_fm(p.read_text())
        if fm is None:
            continue
        name = fm_get(fm, "name") or p.stem
        toml = (f"{GEN_MARK}\nname = {json.dumps(name, ensure_ascii=False)}\n"
                f"description = {json.dumps(fm_get(fm, 'description') or '', ensure_ascii=False)}\n"
                f"developer_instructions = {json.dumps(body.strip(), ensure_ascii=False)}\n")
        tomllib.loads(toml)
        out = CODEX_AGENTS / f"{p.stem}.toml"
        made.add(out.name)
        if not out.exists() or out.read_text() != toml:
            changed += 1
            write_text(out, toml)
    if CODEX_AGENTS.is_dir():
        for p in CODEX_AGENTS.glob("*.toml"):
            if p.name not in made and p.read_text().startswith(GEN_MARK):
                log(f"  - Codex agent {p.stem}")
                DRY or p.unlink()
    if changed:
        log(f"  → agents: {len(files)} agents, {changed} files updated across Claude, Cursor, Codex")


def export_instructions():
    if not INSTR.exists():
        return
    changed = link(INSTR, CLAUDE_MD) + link(INSTR, CODEX_MD)
    rule = ('---\ndescription: Global instructions from ~/.agents/instructions/AGENTS.md\n'
            'alwaysApply: true\n---\n' + INSTR.read_text())
    if not CURSOR_RULE.exists() or CURSOR_RULE.read_text() != rule:
        changed += 1
        write_text(CURSOR_RULE, rule)
    if changed:
        log("  → instructions: Claude CLAUDE.md, Codex AGENTS.md, Cursor rule")


# ---------------------------------------------------------------- 4. groups
AGENT_GROUPS = ["academic", "design", "engineering", "finance", "game-development", "gis", "healthcare",
                "marketing", "paid-media", "product", "project-management", "research", "sales", "security",
                "spatial-computing", "specialized", "support", "testing"]
AGENT_ALIASES = {"paid": "paid-media", "project": "project-management", "game": "game-development",
                 "unity": "game-development", "unreal": "game-development", "godot": "game-development",
                 "roblox": "game-development", "blender": "game-development", "level": "game-development",
                 "narrative": "game-development", "technical": "game-development",
                 "xr": "spatial-computing", "visionos": "spatial-computing", "macos": "spatial-computing",
                 "terminal": "spatial-computing"}


def agent_group(stem):
    for g in sorted(AGENT_GROUPS, key=len, reverse=True):
        if stem.startswith(g + "-"):
            return g
    return AGENT_ALIASES.get(stem.split("-")[0], "specialized")


def build_groups():
    root = HUB / "groups"
    if not DRY:
        shutil.rmtree(root, ignore_errors=True)
    sg = load_json(GROUPS_FILE, {}).get("skills", {})
    where = {s: g for g, ss in sg.items() for s in ss}
    for p in sorted(SKILLS.iterdir()):
        if (p / "SKILL.md").exists():
            DRY or link(p, root / "skills" / where.get(p.name, "ungrouped") / p.name)
    for p in sorted(AGENTS.glob("*.md")):
        DRY or link(p, root / "agents" / agent_group(p.stem) / p.name)
    for base, kind in ((EXP / "skills", "skills"), (EXP / "agents", "agents")):
        if base.is_dir():
            for p in base.iterdir():
                DRY or link(p, root / "experimental" / kind / p.name)


# ---------------------------------------------------------------- 5. git
def git(*a, check=False):
    return subprocess.run(["git", "-C", str(HUB), *a], capture_output=True, text=True, check=check)


def commit_and_push():
    if DRY or not (HUB / ".git").exists():
        return
    git("add", "-A")
    if git("diff", "--cached", "--quiet").returncode == 0:
        log("  ✓ hub unchanged")
    else:
        summary = "; ".join(l.strip() for l in log_lines if l.strip().startswith(("+", "↻", "-", "→")))[:400]
        git("commit", "-q", "-m", "agents-sync: " + (summary or "update"))
        log("  ✓ committed to ~/.agents git")
    if not NO_PUSH and git("remote").stdout.strip():
        r = git("push", "-q", "origin", "HEAD")
        log("  ✓ pushed" if r.returncode == 0 else f"  ! push failed: {r.stderr.strip()}")


def read_env():
    env = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip('"')
    return env


def write_env(env):
    if DRY:
        return
    lines = ["# Secrets for ~/.agents/mcp/servers.json (${VAR} placeholders). Never committed."]
    lines += [f"{k}={json.dumps(v)}" for k, v in sorted(env.items())]
    ENV_FILE.write_text("\n".join(lines) + "\n")
    os.chmod(ENV_FILE, 0o600)


def main():
    for d in (SKILLS, AGENTS, EXP / "skills", EXP / "agents", HUB / "state", MCP_FILE.parent, INSTR.parent):
        DRY or d.mkdir(parents=True, exist_ok=True)
    state = load_json(STATE, {})
    env = read_env()
    hub = load_json(MCP_FILE, {"servers": {}, "unmanaged": []})

    log("import")
    import_skills()
    import_agents()
    import_mcp(hub, env)
    write_env(env)
    if not DRY:
        MCP_FILE.write_text(json.dumps(hub, indent=2, ensure_ascii=False) + "\n")

    log("normalize")
    chars = normalize_agents(AGENTS)
    log(f"  agent names+descriptions ≈ {chars // 4:,} tokens (Claude Code's limit: 15,000)")

    log("export")
    export_skills()
    export_agents(state)
    export_mcp(hub, env, state)
    export_instructions()
    if not DRY:
        STATE.write_text(json.dumps(state, indent=2) + "\n")

    build_groups()
    log("git")
    commit_and_push()


if __name__ == "__main__":
    main()
